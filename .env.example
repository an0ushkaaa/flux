# ─────────────────────────────────────────────────────────────────────────────
# Flux — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic (Claude) — required for the agent brain
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini — used for 768-dim text embeddings (RAG memory)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# CoinGecko — ETH market data (price, volume, market cap)
# Free Demo API key at: https://www.coingecko.com/en/api (sign up → Developer Dashboard)
COINGECKO_API_KEY=

# Etherscan — on-chain wallet data on Sepolia testnet
# Free key at: https://etherscan.io/apis (same key works for Sepolia)
ETHERSCAN_API_KEY=

# Crypto news is sourced from CoinDesk + Cointelegraph RSS feeds.
# No API key needed — nothing to fill in here.

# PostgreSQL connection string — must have the pgvector extension installed
# Local example:  postgresql://postgres:password@localhost:5432/flux
# Supabase/Neon:  copy the connection string from your project dashboard
DATABASE_URL=

# ─── Wallet (Sepolia testnet only) ───────────────────────────────────────────
# 1. Install MetaMask: https://metamask.io
# 2. Create a NEW wallet — never reuse a wallet that holds real funds
# 3. Switch network to "Sepolia test network" in MetaMask settings
# 4. Get free test ETH from: https://sepoliafaucet.com  or  https://faucet.quicknode.com/ethereum/sepolia
# 5. Export the private key from MetaMask: Account Details → Export Private Key
#    WARNING: keep WALLET_PRIVATE_KEY secret — anyone with it controls the wallet
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=

# Ethereum RPC endpoint — Sepolia testnet
# Free public RPC (no sign-up): https://rpc.sepolia.org
# Higher rate limits (free tier): https://www.alchemy.com  or  https://www.infura.io
ETH_RPC_URL=https://rpc.sepolia.org

# ─── Agent behaviour ─────────────────────────────────────────────────────────
# Which trading skill the agent uses. Must match a filename in flux/skills/ (without .txt).
# Options: conservative_dip_buy  |  aggressive_momentum
ACTIVE_SKILL=conservative_dip_buy
